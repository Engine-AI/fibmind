{
  "mcpServers": {
    "fibmind": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "fibmind.mcp_server",
        "--store",
        ".fibmind/memory.db"
      ],
      "env": {
        "FIBMIND_OWNER": "abbila",
        "FIBMIND_APPLICATION": "claude-code"
      }
    }
  }
}
